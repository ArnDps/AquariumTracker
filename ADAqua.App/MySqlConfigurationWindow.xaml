<Window x:Class="ADAqua.App.MySqlConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration MySQL" Height="430" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F7F8">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#172326" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Border Margin="22" Padding="20" Background="White" BorderBrush="#C8D8DA" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" Margin="0,12,0,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Tester" Click="TestConnection_Click" />
                    <Button Content="Enregistrer" Click="Save_Click" Background="#156B6F" Foreground="White" BorderBrush="#156B6F" />
                    <Button Content="Annuler" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="Serveur" />
                    <TextBox Text="{Binding Settings.Server, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="0">
                    <TextBlock Text="Port" />
                    <TextBox Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.ColumnSpan="3" Grid.Row="1">
                    <TextBlock Text="Base de donnees" />
                    <TextBox Text="{Binding Settings.Database, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.ColumnSpan="3" Grid.Row="2">
                    <TextBlock Text="Utilisateur" />
                    <TextBox Text="{Binding Settings.UserId, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.ColumnSpan="3" Grid.Row="3">
                    <TextBlock Text="Mot de passe" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" />
                </StackPanel>
                <TextBlock Grid.ColumnSpan="3" Grid.Row="4" Text="Le mot de passe est chiffre localement avec le compte Windows courant lorsqu'il est enregistre." Foreground="#53696E" TextWrapping="Wrap" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
