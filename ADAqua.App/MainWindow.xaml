        <sys:String x:Key="UiThemeDark">Sombre</sys:String>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,12,12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        </Style>
        <Style x:Key="LongTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="90" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="WaterParameterInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#C62828" />
                    <Setter Property="Background" Value="#FDEAEA" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <local:WaterParameterRangeValidationRule x:Key="AmmoniaRangeRule" Min="0" Max="0.5" ParameterName="Amoniac" />
        <local:WaterParameterRangeValidationRule x:Key="NitritesRangeRule" Min="0" Max="0.2" ParameterName="Nitrites" />
        <local:WaterParameterRangeValidationRule x:Key="NitratesRangeRule" Min="0" Max="50" ParameterName="Nitrates" />
        <local:WaterParameterRangeValidationRule x:Key="PhRangeRule" Min="6" Max="8.5" ParameterName="pH" />
        <local:WaterParameterRangeValidationRule x:Key="GhRangeRule" Min="1" Max="20" ParameterName="GH" />
        <local:WaterParameterRangeValidationRule x:Key="KhRangeRule" Min="0" Max="15" ParameterName="KH" />
        <local:WaterParameterRangeValidationRule x:Key="TemperatureRangeRule" Min="18" Max="30" ParameterName="Temperature" />
        <local:FlexibleDecimalConverter x:Key="FlexibleDecimalConverter" />
        <local:InterventionTypeLabelConverter x:Key="InterventionTypeLabelConverter" />
        <local:InventoryMovementTypeLabelConverter x:Key="InventoryMovementTypeLabelConverter" />
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DatePickerTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{DynamicResource DatePickerTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBrush}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource InputBackgroundBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource TabHeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource TabHeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="12,6"
                                Margin="0,0,4,0"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter x:Name="TabHeaderContent"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                                <Setter TargetName="TabHeaderContent" Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Panel.ZIndex" Value="2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="TabHeaderContent" Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MaxDropDownHeight" Value="340" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Path Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Fill="{TemplateBinding Foreground}"
                                              Data="M 0 0 L 4 4 L 8 0 Z" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlantRefPhCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPhIncompatible}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlantRefGhCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGhIncompatible}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlantRefKhCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKhIncompatible}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlantRefTempCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTemperatureIncompatible}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlantRefNh3CellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAmmoniaIncompatible}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlantRefNo2CellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNitritesIncompatible}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlantRefNo3CellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNitratesIncompatible}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ADAqua" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{DynamicResource UiAppSubtitle}" Foreground="{DynamicResource TextOnHeaderBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource UiSectionAquariums}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="{DynamicResource UiButtonNewAquarium}"
                                Click="NewAquarium_Click"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="{DynamicResource UiButtonDeleteAquarium}"
                                Click="DeleteAquarium_Click"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource ButtonDangerBrush}"
                                BorderBrush="{DynamicResource ButtonDangerBrush}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Aquariums}" SelectedItem="{Binding SelectedAquarium}" DisplayMemberPath="Name" BorderBrush="{DynamicResource CardBorderBrush}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />

                    <TabControl>
                        <TabItem Header="{DynamicResource UiTabSheet}">
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UiLabelName}" />
                                    <TextBox Text="{Binding SelectedAquarium.Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource UiLabelVolume}" />
                                    <TextBox Text="{Binding SelectedAquarium.VolumeLiters, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UiLabelWaterType}" />
                                    <ComboBox ItemsSource="{Binding WaterTypeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Code"
                                              SelectedValue="{Binding SelectedAquariumWaterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,4,12,12"
                                              MinHeight="34" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="{DynamicResource UiLabelStartedOn}" />
                                    <DatePicker SelectedDate="{Binding StartedOnDateTime}" Margin="0,4,12,12" MinHeight="34" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                    <TextBlock Text="{DynamicResource UiLabelNotes}" />
                                    <TextBox Text="{Binding SelectedAquarium.Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongTextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource UiTabParameters}">
                            <DockPanel Margin="0,18,0,0">
                                <UniformGrid DockPanel.Dock="Top" Columns="4">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelAmmonia}" />
                                        <TextBox Style="{StaticResource WaterParameterInputStyle}">
                                            <TextBox.Text>
                                                <Binding Path="NewMeasurement.AmmoniaMgPerLiter" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" NotifyOnValidationError="True" Converter="{StaticResource FlexibleDecimalConverter}">
                                                    <Binding.ValidationRules>
                                                        <StaticResource ResourceKey="AmmoniaRangeRule" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelNitrites}" />
                                        <TextBox Style="{StaticResource WaterParameterInputStyle}">
                                            <TextBox.Text>
                                                <Binding Path="NewMeasurement.NitritesMgPerLiter" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" NotifyOnValidationError="True" Converter="{StaticResource FlexibleDecimalConverter}">
                                                    <Binding.ValidationRules>
                                                        <StaticResource ResourceKey="NitritesRangeRule" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelNitrates}" />
                                        <TextBox Style="{StaticResource WaterParameterInputStyle}">
                                            <TextBox.Text>
                                                <Binding Path="NewMeasurement.NitratesMgPerLiter" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" NotifyOnValidationError="True" Converter="{StaticResource FlexibleDecimalConverter}">
                                                    <Binding.ValidationRules>
                                                        <StaticResource ResourceKey="NitratesRangeRule" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelPh}" />
                                        <TextBox Style="{StaticResource WaterParameterInputStyle}">
                                            <TextBox.Text>
                                                <Binding Path="NewMeasurement.Ph" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" NotifyOnValidationError="True" Converter="{StaticResource FlexibleDecimalConverter}">
                                                    <Binding.ValidationRules>
                                                        <StaticResource ResourceKey="PhRangeRule" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelGh}" />
                                        <TextBox Style="{StaticResource WaterParameterInputStyle}">
                                            <TextBox.Text>
                                                <Binding Path="NewMeasurement.Gh" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" NotifyOnValidationError="True" Converter="{StaticResource FlexibleDecimalConverter}">
                                                    <Binding.ValidationRules>
                                                        <StaticResource ResourceKey="GhRangeRule" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelKh}" />
                                        <TextBox Style="{StaticResource WaterParameterInputStyle}">
                                            <TextBox.Text>
                                                <Binding Path="NewMeasurement.Kh" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" NotifyOnValidationError="True" Converter="{StaticResource FlexibleDecimalConverter}">
                                                    <Binding.ValidationRules>
                                                        <StaticResource ResourceKey="KhRangeRule" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelTemperature}" />
                                        <TextBox Style="{StaticResource WaterParameterInputStyle}">
                                            <TextBox.Text>
                                                <Binding Path="NewMeasurement.TemperatureCelsius" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" NotifyOnValidationError="True" Converter="{StaticResource FlexibleDecimalConverter}">
                                                    <Binding.ValidationRules>
                                                        <StaticResource ResourceKey="TemperatureRangeRule" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelNotes}" />
                                        <TextBox Text="{Binding NewMeasurement.Notes}" Style="{StaticResource LongTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Button Content="{DynamicResource UiButtonAddMeasurement}" Click="AddMeasurement_Click" />
                                    <Button Content="{DynamicResource UiButtonDuplicateMeasurement}" Click="DuplicateMeasurement_Click" />
                                    <Button Content="{DynamicResource UiButtonDeleteMeasurement}" Click="DeleteMeasurement_Click" Background="{DynamicResource ButtonDangerBrush}" BorderBrush="{DynamicResource ButtonDangerBrush}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding SelectedAquarium.Measurements}"
                                          SelectedItem="{Binding SelectedMeasurement}"
                                          IsReadOnly="False"
                                          CellEditEnding="MeasurementGrid_CellEditEnding"
                                          RowEditEnding="MeasurementGrid_RowEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{DynamicResource UiGridDate}" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MeasuredAt, StringFormat={}{0:g}}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding MeasuredOnDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                MinHeight="32"
                                                                VerticalContentAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="NH3/NH4" Binding="{Binding AmmoniaMgPerLiter, Converter={StaticResource FlexibleDecimalConverter}}" Width="*" />
                                        <DataGridTextColumn Header="NO2" Binding="{Binding NitritesMgPerLiter, Converter={StaticResource FlexibleDecimalConverter}}" Width="*" />
                                        <DataGridTextColumn Header="NO3" Binding="{Binding NitratesMgPerLiter, Converter={StaticResource FlexibleDecimalConverter}}" Width="*" />
                                        <DataGridTextColumn Header="pH" Binding="{Binding Ph, Converter={StaticResource FlexibleDecimalConverter}}" Width="*" />
                                        <DataGridTextColumn Header="GH" Binding="{Binding Gh, Converter={StaticResource FlexibleDecimalConverter}}" Width="*" />
                                        <DataGridTextColumn Header="KH" Binding="{Binding Kh, Converter={StaticResource FlexibleDecimalConverter}}" Width="*" />
                                        <DataGridTextColumn Header="C" Binding="{Binding TemperatureCelsius, Converter={StaticResource FlexibleDecimalConverter}}" Width="*" />
                                        <DataGridTextColumn Header="{DynamicResource UiLabelNotes}" Binding="{Binding Notes}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{DynamicResource UiTabHealth}">
                            <Grid Margin="0,18,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                    <StackPanel>
                                        <WrapPanel>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{DynamicResource UiHealthLastMeasure}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding HealthLastMeasurementAt}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource UiHealthGlobalStatus}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding HealthGlobalStatus}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{DynamicResource UiHealthTrends}" FontWeight="SemiBold" Margin="0,10,0,8" />
                                        <DataGrid ItemsSource="{Binding HealthIndicators}" IsReadOnly="True" MaxHeight="210">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Parametre" Binding="{Binding Name}" Width="*" />
                                                <DataGridTextColumn Header="Valeur" Binding="{Binding LatestDisplay}" Width="*" />
                                                <DataGridTextColumn Header="{DynamicResource UiHealthTargetRange}" Binding="{Binding TargetRange}" Width="*" />
                                                <DataGridTextColumn Header="Tendance" Binding="{Binding Trend}" Width="*" />
                                                <DataGridTextColumn Header="Alerte" Binding="{Binding Alert}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource UiHealthActions}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ListBox ItemsSource="{Binding HealthRecommendedActions}" MinHeight="180" MaxHeight="252" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource UiHealthPeriod}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding SelectedTrendPeriodDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="180">
                                            <ComboBoxItem Content="{DynamicResource UiHealthPeriod7}" Tag="7" />
                                            <ComboBoxItem Content="{DynamicResource UiHealthPeriod30}" Tag="30" />
                                            <ComboBoxItem Content="{DynamicResource UiHealthPeriod90}" Tag="90" />
                                            <ComboBoxItem Content="{DynamicResource UiHealthPeriodAll}" Tag="0" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource UiHealthParameters}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding TrendParameterOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,12,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                    <TextBlock Text="{DynamicResource UiHealthCharts}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding HealthTrendSeries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            Margin="0,0,8,8"
                                                            Padding="8"
                                                            Width="270">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding LatestValueLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,6" />
                                                            <Grid Width="250" ClipToBounds="True">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="150" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Canvas Width="250" Height="150" Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
                                                                    <Line X1="24" Y1="8" X2="242" Y2="8"
                                                                          Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="0.6" />
                                                                    <Line X1="24" Y1="70" X2="242" Y2="70"
                                                                          Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="0.6" />
                                                                    <Line X1="24" Y1="132" X2="242" Y2="132"
                                                                          Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="0.6" />
                                                                    <Line X1="24" Y1="8" X2="24" Y2="132"
                                                                          Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="0.6" />
                                                                    <Line X1="133" Y1="8" X2="133" Y2="132"
                                                                          Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="0.6" />
                                                                    <Line X1="242" Y1="8" X2="242" Y2="132"
                                                                          Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="0.6" />
                                                                    <Line X1="24" Y1="8"
                                                                          X2="24" Y2="132"
                                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                                          StrokeThickness="1" />
                                                                    <Line X1="24" Y1="132"
                                                                          X2="242" Y2="132"
                                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                                          StrokeThickness="1" />
                                                                    <Polyline Points="{Binding Points}"
                                                                              Stroke="{DynamicResource ButtonPrimaryBrush}"
                                                                              StrokeThickness="2" />
                                                                    <TextBlock Canvas.Left="0" Canvas.Top="2" Width="22" TextAlignment="Right"
                                                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               Text="{Binding YTopLabel}" />
                                                                    <TextBlock Canvas.Left="0" Canvas.Top="64" Width="22" TextAlignment="Right"
                                                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               Text="{Binding YMidLabel}" />
                                                                    <TextBlock Canvas.Left="0" Canvas.Top="126" Width="22" TextAlignment="Right"
                                                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               Text="{Binding YBottomLabel}" />
                                                                </Canvas>
                                                                <Grid Grid.Row="1" Margin="24,4,8,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" Text="{Binding XStartLabel}" />
                                                                    <TextBlock Grid.Column="1" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding XMidLabel}" />
                                                                    <TextBlock Grid.Column="2" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding XEndLabel}" />
                                                                </Grid>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                           Text="{DynamicResource UiHealthNoData}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HealthIndicators.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{DynamicResource UiHealthNoChartData}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HealthTrendSeries.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource UiTabPlants}">
                            <DockPanel Margin="0,18,0,0">
                                <UniformGrid DockPanel.Dock="Top" Columns="9">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiPlantReferenceChoice}" />
                                        <ComboBox ItemsSource="{Binding PlantReferenceChoices}"
                                                  SelectedItem="{Binding SelectedPlantReferenceForNewPlant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="LocalizedCommonName"
                                                  TextSearch.TextPath="LocalizedCommonName"
                                                  IsTextSearchEnabled="True"
                                                  Margin="0,4,12,12"
                                                  MinHeight="34" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiPlantCommonName}" />
                                        <TextBox Text="{Binding NewPlant.CommonName}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiPlantScientificName}" />
                                        <TextBox Text="{Binding NewPlant.ScientificName}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiAddedOn}" />
                                        <DatePicker SelectedDate="{Binding NewPlant.AddedOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Margin="0,4,12,12"
                                                    MinHeight="34"
                                                    VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiInventoryMovement}" />
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding NewPlant.MovementType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,4,12,12"
                                                  MinHeight="34">
                                            <ComboBoxItem Content="{DynamicResource UiMovementAddition}" Tag="{x:Static domain:InventoryMovementType.Addition}" />
                                            <ComboBoxItem Content="{DynamicResource UiMovementRemoval}" Tag="{x:Static domain:InventoryMovementType.Removal}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiPlantQuantity}" />
                                        <TextBox Text="{Binding NewPlant.Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiPlantGrowth}" />
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding NewPlant.GrowthSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,4,12,12"
                                                  MinHeight="34">
                                            <ComboBoxItem Content="{DynamicResource UiGrowthSlow}" Tag="{x:Static domain:PlantGrowthSpeed.Slow}" />
                                            <ComboBoxItem Content="{DynamicResource UiGrowthMedium}" Tag="{x:Static domain:PlantGrowthSpeed.Medium}" />
                                            <ComboBoxItem Content="{DynamicResource UiGrowthFast}" Tag="{x:Static domain:PlantGrowthSpeed.Fast}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiPlantLightNeed}" />
                                        <ComboBox Text="{Binding NewPlant.LightNeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,4,12,12"
                                                  MinHeight="34">
                                            <ComboBoxItem Content="{DynamicResource UiLightLow}" />
                                            <ComboBoxItem Content="{DynamicResource UiLightMedium}" />
                                            <ComboBoxItem Content="{DynamicResource UiLightHigh}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UiLabelNotes}" />
                                        <TextBox Text="{Binding NewPlant.Notes}" Style="{StaticResource LongTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Button Content="{DynamicResource UiButtonAddPlantMovement}" Click="AddPlant_Click" />
                                    <Button Content="{DynamicResource UiButtonDeletePlantMovement}" Click="DeletePlant_Click" Background="{DynamicResource ButtonDangerBrush}" BorderBrush="{DynamicResource ButtonDangerBrush}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DataGrid Grid.Row="0"
                                              ItemsSource="{Binding SelectedAquarium.Plants}"
                                              SelectedItem="{Binding SelectedPlant}"
                                              IsReadOnly="False"
                                              CellEditEnding="PlantGrid_CellEditEnding"
                                              RowEditEnding="PlantGrid_RowEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="130" SortMemberPath="AddedOn">
                                                <DataGridTemplateColumn.Header>
                                                    <TextBlock Text="{DynamicResource UiAddedOn}" />
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding AddedOn, StringFormat={}{0:d}}" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <DatePicker SelectedDate="{Binding AddedOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    MinHeight="32"
                                                                    VerticalContentAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="120" SortMemberPath="MovementType">
                                                <DataGridTemplateColumn.Header>
                                                    <TextBlock Text="{DynamicResource UiInventoryMovement}" />
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource InventoryMovementTypeLabelConverter}">
                                                                    <Binding Path="MovementType" />
                                                                    <Binding Path="DataContext.MovementLocalizationVersion" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox SelectedValuePath="Tag"
                                                                  SelectedValue="{Binding MovementType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  MinHeight="32"
                                                                  Margin="0">
                                                            <ComboBoxItem Content="{DynamicResource UiMovementAddition}" Tag="{x:Static domain:InventoryMovementType.Addition}" />
                                                            <ComboBoxItem Content="{DynamicResource UiMovementRemoval}" Tag="{x:Static domain:InventoryMovementType.Removal}" />
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Binding="{Binding Quantity}" Width="90">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="{DynamicResource UiPlantQuantity}" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
