        <sys:String x:Key="UiButtonDeletePopulation">Supprimer la population</sys:String>
        <sys:String x:Key="UiButtonAddPopulationMovement">Ajouter le mouvement</sys:String>
        <sys:String x:Key="UiButtonDeletePopulationMovement">Supprimer la ligne</sys:String>
        <sys:String x:Key="UiInterventionDate">Date</sys:String>
        <sys:String x:Key="UiInterventionTime">Heure</sys:String>
        <sys:String x:Key="UiInterventionType">Type</sys:String>
